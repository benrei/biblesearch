{
  "name": "biblesearch",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "user": "node",
  "install": "bun install --frozen-lockfile",
  "terminals": [
    {
      "name": "dev server",
      "command": "bun run start -- --host 0.0.0.0 --port 4200"
    }
  ],
  "ports": [
    {
      "name": "dev server",
      "port": 4200
    }
  ]
}
